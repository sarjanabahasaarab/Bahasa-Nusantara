{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NUSANTARA",
  "scopeName": "source.nusantara",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nusantara",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nusantara",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nusantara",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nusantara",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nusantara",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nusantara",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nusantara",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nusantara",
          "match": "\\b(jika|maka|selain|akhir|selama|untuk|dari|sampai|lakukan|hentikan|lanjutkan|kembalikan|mulai|selesai)\\b"
        },
        {
          "name": "keyword.declaration.nusantara",
          "match": "\\b(program|fungsi|variabel|tetap|modul|gunakan|ekspor|sebagai|impor)\\b"
        },
        {
          "name": "constant.language.boolean.nusantara",
          "match": "\\b(benar|salah)\\b"
        },
        {
          "name": "constant.language.null.nusantara",
          "match": "\\b(kosong)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.nusantara",
          "match": "\\b(teks|bilangan|desimal|logika|karakter|daftar|peta)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nusantara",
          "match": "\\b(tampilkan|masukan|panjang)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.nusantara",
          "match": "\\b(dan|atau|tidak)\\b"
        },
        {
          "name": "keyword.operator.comparison.nusantara",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.nusantara",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.nusantara",
          "match": "(=)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfungsi\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.nusantara"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.nusantara"
            }
          }
        }
      ]
    }
  }
}
